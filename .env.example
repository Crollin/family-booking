# =============================================================================
# family-booking — configuration
# =============================================================================
# Copiez ce fichier en `.env` puis lancez `docker compose up -d`.
# Tel quel, il produit une instance fonctionnelle sur http://localhost:3000.
#
# ATTENTION : les secrets ci-dessous sont publics (ils sont dans ce dépôt).
# Avant toute mise en ligne, régénérez-les :
#
#     ./scripts/generate-secrets.sh
#
# Référence complète des variables : docs/CONFIGURATION.md
# =============================================================================


# -----------------------------------------------------------------------------
# Adresse publique
# -----------------------------------------------------------------------------
# URL de l'interface (et, en pile complète, aussi celle de Supabase via le proxy).
# En production : votre domaine, ex. https://reservations.mondomaine.fr
PUBLIC_URL=http://localhost:3000

# Port publié sur la machine hôte.
APP_PORT=3000

# --- Mode app seule (`docker compose -f docker-compose.app.yml`) -------------
# Si vous utilisez un Supabase déjà existant, renseignez son URL API publique.
# Laissez vide en pile complète : l'app réutilise alors PUBLIC_URL.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# Optionnel : URL joignable depuis le conteneur app (réseau privé / Docker).
# SUPABASE_INTERNAL_URL=


# -----------------------------------------------------------------------------
# Identité du site (branding)
# -----------------------------------------------------------------------------
SITE_NAME=Family Lodge
SITE_TAGLINE=Réservations familiales partagées
PROPERTY_LAT=45.0
PROPERTY_LNG=6.0


# -----------------------------------------------------------------------------
# Secrets — À REMPLACER avant toute mise en ligne
# -----------------------------------------------------------------------------
# ANON_KEY et SERVICE_ROLE_KEY sont des jetons JWT signés avec JWT_SECRET :
# les trois valeurs forment un tout et se régénèrent ensemble.
POSTGRES_PASSWORD=family-booking-local-dev-password
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.WBy0cwHZi6al6_y5Ky2zA_Nj0zTfn8oOH5Q0FVMK-H4
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.liZeOW86sassc8VY5vOdh6iSJFH7aoote5Mbt4vMG3c
SECRET_KEY_BASE=family-booking-local-dev-secret-key-base-change-me-please

# Protège les routes de tâches planifiées (/api/cron/*).
CRON_SECRET=family-booking-local-dev-cron-secret


# -----------------------------------------------------------------------------
# Envoi d'e-mails (facultatif)
# -----------------------------------------------------------------------------
# Sans configuration, l'application fonctionne : les invitations et les
# notifications ne sont simplement pas envoyées.
#
# Renseignez SOIT un serveur SMTP, SOIT une clé Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

RESEND_API_KEY=
RESEND_FROM=

# auto (défaut) : SMTP en premier, Resend en secours. Ou forcez : smtp | resend
EMAIL_PROVIDER=auto

# Restreint le bouton « e-mail de test » de l'admin à ces adresses
# (séparées par des virgules). Vide = tous les administrateurs.
PLATFORM_OWNER_EMAILS=


# -----------------------------------------------------------------------------
# Météo (facultatif)
# -----------------------------------------------------------------------------
# La météo utilise Open-Meteo (gratuit, sans clé ni inscription).
# Renseignez les coordonnées de votre logement.
WEATHER_LOCATION=Exemple, FR
WEATHER_LATITUDE=45.0
WEATHER_LONGITUDE=6.0
WEATHER_ELEVATION=1000
WEATHER_API_KEY=


# -----------------------------------------------------------------------------
# Protections supplémentaires (facultatif)
# -----------------------------------------------------------------------------
# CAPTCHA Cloudflare Turnstile sur les formulaires d'inscription.
# Les deux clés vont ensemble : sans elles, le CAPTCHA est désactivé.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mot de passe HTTP devant tout le site, utile pendant une phase de recette.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Partage du cookie de session entre sous-domaines (ex. .mondomaine.fr).
# Laissez vide dans la quasi-totalité des cas.
COOKIE_DOMAIN=
